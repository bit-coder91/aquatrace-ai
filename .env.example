# Local demo project. These public Firebase web configuration values are
# placeholders for emulator mode and are not production credentials.
FIREBASE_PROJECT_ID=demo-aquatrace-local
FIREBASE_EMULATOR_MODE=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-aquatrace-local.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-aquatrace-local
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:local-aquatrace
NEXT_PUBLIC_FIREBASE_EMULATOR=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
FIREBASE_STORAGE_BUCKET=demo-aquatrace-local.firebasestorage.app

# Firebase Admin SDK emulator endpoints. Do not set emulator variables in
# production environments.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Server-side Storage emulator access is experimental and must be verified.
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199

# Local-only optional service-account path. Never commit a key file.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/path/firebase-service-account.json

