rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The browser uses Firebase Authentication only. All operational data
    // access goes through the Spring Boot API, which verifies membership and
    // role before using the Admin SDK. Admin SDK calls bypass these rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
